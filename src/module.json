        "name": "Follow",
        "type": "enum",
        "options": [
          "Manual",
          "LFO",
          "Sequence"
        ]
      },
      {
        "key": "repeat_avoid",
        "name": "Repeat Avoid",
        "type": "int",
        "min": 0,
        "max": 16,
        "default": 4
      },
      {
        "key": "smooth",
        "name": "Smooth",
        "type": "float",
        "min": 0,
        "max": 1,
        "default": 0.35,
        "step": 0.01
      },
      {
        "key": "lfo_rate",
        "name": "LFO Rate",
        "type": "float",
        "min": 0.01,
        "max": 10,
        "default": 0.2,
        "step": 0.01,
        "unit": "Hz",
        "viz": {
          "group": "lfo",
          "role": "rate"
        }
      },
      {
        "key": "lfo_shape",
        "name": "LFO Shape",
        "type": "enum",
        "options": [
          "Circle",
          "SineX",
          "SineY",
          "S&H"
        ],
        "viz": {
          "group": "lfo",
          "role": "shape"
        }
      },
      {
        "key": "density",
        "name": "Density",
        "type": "float",
        "min": 1,
        "max": 100,
        "default": 20,
        "step": 1,
        "unit": "g/s",
        "display_format": "%.0f"
      },
      {
