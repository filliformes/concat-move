{
  "id": "concat",
  "name": "Concat",
  "version": "0.1.0",
  "api_version": 2,
  "description": "Corpus concatenative synthesis: navigate a timbre map across a whole sample folder, or mosaic live input.",
  "author": "Filliformes",
  "abbrev": "CONCAT",
  "dsp": "dsp.so",
  "component_type": "sound_generator",
  "raw_midi": true,
  "min_host_version": "0.9.10",
  "capabilities": {
    "audio_out": true,
    "midi_in": true,
    "chainable": true,
    "component_type": "sound_generator",
    "ui_hierarchy": {
      "modes": null,
      "levels": {
        "root": {
          "name": "Concat",
          "knobs": ["corpus_file", "pool_mb", "rescan", "slice_mode", "min_slice_ms", "max_slice_ms", "analyze", "silence_gate"],
          "params": [
            {"level": "map", "label": "Map"},
            {"level": "grain", "label": "Grain"},
            {"level": "play", "label": "Play / Out"}
          ]
        },
        "map": {
          "name": "Map",
          "knobs": ["x_desc", "y_desc", "x_pos", "y_pos", "radius", "k_nearest", "follow", "repeat_avoid"],
          "params": ["x_desc", "y_desc", "x_pos", "y_pos", "radius", "k_nearest", "follow", "repeat_avoid"]
        },
        "grain": {
          "name": "Grain",
          "knobs": ["density", "grain_size", "grain_env", "pitch", "pitch_jitter", "pan_spread", "reverse"],
          "params": ["density", "grain_size", "grain_env", "pitch", "pitch_jitter", "pan_spread", "reverse"]
        },
        "play": {
          "name": "Play / Out",
          "knobs": ["play_mode", "input_src", "mosaic_rate", "note_match", "dry_mix", "volume", "width", "sat"],
          "params": ["play_mode", "input_src", "mosaic_rate", "note_match", "dry_mix", "volume", "width", "sat"]
        }
      }
    },
    "chain_params": [
      {"key": "corpus_file", "name": "Source", "type": "filepath", "root": "/data/UserData", "filter": [".wav", ".flac", ".mp3"], "default": ""},
      {"key": "pool_mb", "name": "Pool Cap", "type": "int", "min": 16, "max": 512, "default": 128, "unit": "MB"},
      {"key": "rescan", "name": "Rescan", "type": "int", "min": 0, "max": 127, "default": 0},
      {"key": "slice_mode", "name": "Slice Mode", "type": "enum", "options": ["Onset", "Fixed"]},
      {"key": "min_slice_ms", "name": "Min Slice", "type": "float", "min": 20, "max": 500, "default": 60, "step": 5, "unit": "ms", "display_format": "%.0f"},
      {"key": "max_slice_ms", "name": "Max Slice", "type": "float", "min": 100, "max": 2000, "default": 400, "step": 10, "unit": "ms", "display_format": "%.0f"},
      {"key": "analyze", "name": "Analyze", "type": "int", "min": 0, "max": 100, "default": 0, "unit": "%"},
      {"key": "silence_gate", "name": "Silence Gate", "type": "float", "min": 0, "max": 1, "default": 0.1, "step": 0.01},
      {"key": "x_desc", "name": "X Descriptor", "type": "enum", "options": ["Bright", "Pitch", "Loud", "Noisy", "Rolloff", "MFCC1", "MFCC2", "MFCC3"]},
      {"key": "y_desc", "name": "Y Descriptor", "type": "enum", "options": ["Bright", "Pitch", "Loud", "Noisy", "Rolloff", "MFCC1", "MFCC2", "MFCC3"]},
      {"key": "x_pos", "name": "X Position", "type": "float", "min": 0, "max": 1, "default": 0.5, "step": 0.01},
      {"key": "y_pos", "name": "Y Position", "type": "float", "min": 0, "max": 1, "default": 0.5, "step": 0.01},
      {"key": "radius", "name": "Radius", "type": "float", "min": 0, "max": 1, "default": 0.15, "step": 0.01},
      {"key": "k_nearest", "name": "K Nearest", "type": "int", "min": 1, "max": 16, "default": 4},
      {"key": "follow", "name": "Follow", "type": "enum", "options": ["Manual", "LFO", "Sequence"]},
      {"key": "repeat_avoid", "name": "Repeat Avoid", "type": "int", "min": 0, "max": 16, "default": 4},
      {"key": "density", "name": "Density", "type": "float", "min": 1, "max": 100, "default": 20, "step": 1, "unit": "g/s", "display_format": "%.0f"},
      {"key": "grain_size", "name": "Grain Size", "type": "float", "min": 10, "max": 500, "default": 120, "step": 5, "unit": "ms", "display_format": "%.0f"},
      {"key": "grain_env", "name": "Grain Env", "type": "enum", "options": ["Hann", "Tukey", "Tri"]},
      {"key": "pitch", "name": "Pitch", "type": "float", "min": -24, "max": 24, "default": 0, "step": 1, "unit": "st", "display_format": "%.0f"},
      {"key": "pitch_jitter", "name": "Pitch Jitter", "type": "float", "min": 0, "max": 1, "default": 0, "step": 0.01},
      {"key": "pan_spread", "name": "Pan Spread", "type": "float", "min": 0, "max": 1, "default": 0.3, "step": 0.01},
      {"key": "reverse", "name": "Reverse", "type": "float", "min": 0, "max": 1, "default": 0, "step": 0.01},
      {"key": "play_mode", "name": "Play Mode", "type": "enum", "options": ["Map", "Notes", "Mosaic"]},
      {"key": "input_src", "name": "Input Src", "type": "enum", "options": ["Line", "Mic"]},
      {"key": "mosaic_rate", "name": "Mosaic Rate", "type": "enum", "options": ["Onset", "1/16", "1/8", "1/4"]},
      {"key": "note_match", "name": "Note Match", "type": "enum", "options": ["Off", "Pitch", "Zone"]},
      {"key": "dry_mix", "name": "Dry Mix", "type": "float", "min": 0, "max": 1, "default": 0, "step": 0.01},
      {"key": "volume", "name": "Volume", "type": "float", "min": 0, "max": 1, "default": 0.8, "step": 0.01},
      {"key": "width", "name": "Width", "type": "float", "min": 0, "max": 1, "default": 1.0, "step": 0.01},
      {"key": "sat", "name": "Saturation", "type": "float", "min": 0, "max": 1, "default": 0, "step": 0.01}
    ]
  }
}
