{
  "id": "concat",
  "name": "Concat",
  "version": "0.2.0",
  "api_version": 2,
  "description": "Corpus concatenative synthesis: navigate a timbre map across a whole sample folder, or mosaic live input.",
  "author": "Filliformes",
  "abbrev": "CONCAT",
  "dsp": "dsp.so",
  "component_type": "sound_generator",
  "raw_midi": true,
  "min_host_version": "0.9.10",
  "capabilities": {
    "audio_out": true,
    "midi_in": true,
    "chainable": true,
    "component_type": "sound_generator",
    "ui_hierarchy": {
      "modes": null,
      "levels": {
        "root": {
          "name": "Concat",
          "knobs": [
            "x_pos",
            "y_pos",
            "density",
            "grain_size",
            "amp_atk",
            "amp_rel",
            "poly",
            "cutoff"
          ],
          "params": [
            "x_pos",
            "y_pos",
            "density",
            "grain_size",
            "amp_atk",
            "amp_rel",
            "poly",
            "cutoff",
            {
              "level": "view",
              "label": "View"
            },
            {
              "level": "corpus",
              "label": "Corpus"
            },
            {
              "level": "map",
              "label": "Map"
            },
            {
              "level": "mod_set",
              "label": "Mod & Set"
            },
            {
              "level": "grain",
              "label": "Grain"
            },
            {
              "level": "shape",
              "label": "Shape"
            },
            {
              "level": "play",
              "label": "Play"
            },
            {
              "level": "out",
              "label": "Out"
            }
          ]
        },
        "map": {
          "name": "Map",
          "knobs": [
            "x_desc",
            "y_desc",
            "x_pos",
            "y_pos",
            "map_mode",
            "radius",
            "k_nearest",
            "repeat_avoid"
          ],
          "params": [
            "x_desc",
            "y_desc",
            "x_pos",
            "y_pos",
            "map_mode",
            "radius",
            "k_nearest",
            "repeat_avoid"
          ]
        },
        "grain": {
          "name": "Grain",
          "knobs": [
            "density",
            "grain_size",
            "grain_env",
            "pitch",
            "pan_spread",
            "grain_rand",
            "reverse",
            "pitch_jitter"
          ],
          "params": [
            "density",
            "grain_size",
            "grain_env",
            "pitch",
            "pan_spread",
            "grain_rand",
            "reverse",
            "pitch_jitter"
          ]
        },
        "shape": {
          "name": "Shape",
          "knobs": [
            "amp_atk",
            "amp_dec",
            "amp_sus",
            "amp_rel",
            "filt_amt",
            "filt_atk",
            "filt_dec",
            "filt_sus"
          ],
          "params": [
            "amp_atk",
            "amp_dec",
            "amp_sus",
            "amp_rel",
            "filt_amt",
            "filt_atk",
            "filt_dec",
            "filt_sus"
          ]
        },
        "play": {
          "name": "Play",
          "knobs": [
            "play_mode",
            "note_match",
            "pressure",
            "press_amt",
            "vel_amt",
            "poly"
          ],
          "params": [
            "play_mode",
            "note_match",
            "pressure",
            "press_amt",
            "vel_amt",
            "poly"
          ]
        },
        "out": {
          "name": "Out",
          "knobs": [
            "cutoff",
            "resonance",
            "sat",
            "dry_mix",
            "volume",
            "width",
            "level_norm"
          ],
          "params": [
            "cutoff",
            "resonance",
            "sat",
            "dry_mix",
            "volume",
            "width",
            "level_norm"
          ]
        },
        "corpus": {
          "name": "Corpus",
          "knobs": [
            "corpus_file",
            "pool_mb",
            "rescan",
            "slice_mode",
            "min_slice_ms",
            "max_slice_ms",
            "analyze",
            "silence_gate"
          ],
          "params": [
            "corpus_file",
            "pool_mb",
            "rescan",
            "slice_mode",
            "min_slice_ms",
            "max_slice_ms",
            "analyze",
            "silence_gate"
          ]
        },
        "view": {
          "name": "View",
          "knobs": [
            "x_pos",
            "y_pos",
            "radius",
            "density",
            "grain_size",
            "k_nearest",
            "smooth",
            "cutoff"
          ],
          "params": [
            "map_view",
            "x_pos",
            "y_pos",
            "radius",
            "density",
            "grain_size",
            "k_nearest",
            "smooth",
            "cutoff"
          ],
          "list_param": "preset_index",
          "count_param": "preset_count",
          "name_param": "preset_name"
        },
        "mod_set": {
          "name": "Mod & Set",
          "knobs": [
            "follow",
            "lfo_rate",
            "lfo_shape",
            "smooth",
            "pos_jitter",
            "src_scope"
          ],
          "params": [
            "follow",
            "lfo_rate",
            "lfo_shape",
            "smooth",
            "pos_jitter",
            "src_scope"
          ]
        }
      }
    },
    "chain_params": [
      {
        "key": "corpus_file",
        "name": "Source",
        "type": "filepath",
        "root": "/data/UserData/UserLibrary",
        "filter": [
          ".wav",
          ".aif",
          ".aiff",
          ".flac",
          ".mp3",
          ".concat"
        ],
        "default": ""
      },
      {
        "key": "map_view",
        "name": "View",
        "type": "canvas",
        "canvas_script": "canvas.js",
        "as_page": true,
        "show_value": false,
        "extra_keys": [
          "map_live",
          "map_pts",
          "corpus_status"
        ],
        "preset_browser": true
      },
      {
        "key": "map_live",
        "name": "Live",
        "type": "string",
        "access": "read"
      },
      {
        "key": "map_pts",
        "name": "Pts",
        "type": "string",
        "access": "read"
      },
      {
        "key": "corpus_status",
        "name": "Status",
        "type": "string",
        "access": "read"
      },
      {
        "key": "preset_index",
        "name": "Recipe",
        "type": "int",
        "min": 0,
        "max": 7
      },
      {
        "key": "preset_count",
        "name": "Recipes",
        "type": "int",
        "min": 0,
        "max": 8,
        "access": "read"
      },
      {
        "key": "preset_name",
        "name": "Recipe",
        "type": "string",
        "access": "read"
      },
      {
        "key": "src_scope",
        "name": "Scope",
        "type": "enum",
        "options": [
          "Folder",
          "File"
        ]
      },
      {
        "key": "pool_mb",
        "name": "Pool Cap",
        "type": "int",
        "min": 16,
        "max": 512,
        "default": 128,
        "unit": "MB"
      },
      {
        "key": "rescan",
        "name": "Rescan",
        "type": "int",
        "min": 0,
        "max": 127,
        "default": 0
      },
      {
        "key": "slice_mode",
        "name": "Slice Mode",
        "type": "enum",
        "options": [
          "Onset",
          "Fixed"
        ]
      },
      {
        "key": "min_slice_ms",
        "name": "Min Slice",
        "type": "float",
        "min": 20,
        "max": 500,
        "default": 20,
        "step": 5,
        "unit": "ms",
        "display_format": "%.0f"
      },
      {
        "key": "max_slice_ms",
        "name": "Max Slice",
        "type": "float",
        "min": 100,
        "max": 2000,
        "default": 2000,
        "step": 10,
        "unit": "ms",
        "display_format": "%.0f"
      },
      {
        "key": "analyze",
        "name": "Analyze",
        "type": "int",
        "min": 0,
        "max": 100,
        "default": 0,
        "unit": "%"
      },
      {
        "key": "silence_gate",
        "name": "Silence Gate",
        "type": "float",
        "min": 0,
        "max": 1,
        "default": 0.02
      },
      {
        "key": "map_mode",
        "name": "Map Mode",
        "type": "enum",
        "options": [
          "Raw",
          "Learned"
        ]
      },
      {
        "key": "x_desc",
        "name": "X Descriptor",
        "type": "enum",
        "options": [
          "Bright",
          "Pitch",
          "Loud",
          "Noisy",
          "Rolloff",
          "MFCC1",
          "MFCC2",
          "MFCC3"
        ]
      },
      {
        "key": "y_desc",
        "name": "Y Descriptor",
        "type": "enum",
        "options": [
          "Bright",
          "Pitch",
          "Loud",
          "Noisy",
          "Rolloff",
          "MFCC1",
          "MFCC2",
          "MFCC3"
        ]
      },
      {
        "key": "x_pos",
        "name": "X Position",
        "type": "float",
        "min": 0,
        "max": 1,
        "default": 0.5
      },
      {
        "key": "y_pos",
        "name": "Y Position",
        "type": "float",
        "min": 0,
        "max": 1,
        "default": 0.5
      },
      {
        "key": "radius",
        "name": "Radius",
        "type": "float",
        "min": 0,
        "max": 1,
        "default": 0.15
      },
      {
        "key": "k_nearest",
        "name": "K Nearest",
        "type": "int",
        "min": 1,
        "max": 16,
        "default": 4
      },
      {
