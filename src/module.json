      {
        "key": "corpus_file",
        "name": "Source",
        "type": "filepath",
        "root": "/data/UserData/UserLibrary",
        "filter": [
          ".wav",
          ".flac",
          ".mp3"
        ],
        "default": ""
      },
      {
        "key": "src_scope",
        "name": "Scope",
        "type": "enum",
        "options": [
          "Folder",
          "File"
        ]
      },
      {
        "key": "pool_mb",
        "name": "Pool",
        "type": "int",
        "min": 16,
        "max": 512,
        "default": 128,
        "unit": "MB"
      },
      {
        "key": "rescan",
        "name": "Rescan",
        "type": "int",
        "min": 0,
        "max": 127,
        "default": 0
      },
      {
        "key": "slice_mode",
        "name": "Slice",
        "type": "enum",
        "options": [
          "Onset",
          "Fixed"
        ]
      },
      {
        "key": "min_slice_ms",
        "name": "Min Sl",
        "type": "float",
        "min": 20,
        "max": 500,
        "default": 60,
        "step": 5,
        "unit": "ms",
        "display_format": "%.0f"
      },
      {
        "key": "max_slice_ms",
        "name": "Max Sl",
        "type": "float",
        "min": 100,
        "max": 2000,
        "default": 400,
        "step": 10,
        "unit": "ms",
        "display_format": "%.0f"
