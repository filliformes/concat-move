            "density",
            "grain_size",
            "grain_env",
            "pitch",
            "pan_spread",
            "grain_rand",
            "reverse",
            "pitch_jitter"
          ]
        },
        "shape": {
          "name": "Shape",
          "knobs": [
            "amp_atk",
            "amp_dec",
            "amp_sus",
            "amp_rel",
            "filt_amt",
            "filt_atk",
            "filt_dec",
            "filt_sus"
          ],
          "params": [
            "amp_atk",
            "amp_dec",
            "amp_sus",
            "amp_rel",
            "filt_amt",
            "filt_atk",
            "filt_dec",
            "filt_sus"
          ]
        },
        "play": {
          "name": "Play",
          "knobs": [
            "play_mode",
            "note_match",
            "pressure",
            "press_amt",
            "vel_amt",
            "poly"
          ],
          "params": [
            "play_mode",
            "note_match",
            "pressure",
            "press_amt",
            "vel_amt",
            "poly"
          ]
        },
