          "name": "Out",
          "knobs": [
            "cutoff",
            "resonance",
            "sat",
            "dry_mix",
            "volume",
            "width"
          ],
          "params": [
            "cutoff",
            "resonance",
            "sat",
            "dry_mix",
            "volume",
            "width"
          ]
        },
        "corpus": {
          "name": "Corpus",
          "knobs": [
            "corpus_file",
            "pool_mb",
            "rescan",
            "slice_mode",
            "min_slice_ms",
            "max_slice_ms",
            "analyze",
            "silence_gate"
