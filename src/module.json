{
  "id": "concat",
  "name": "Concat",
  "version": "0.1.0",
  "api_version": 2,
  "description": "Corpus concatenative synthesis: navigate a timbre map across a whole sample folder, or mosaic live input.",
  "author": "Filliformes",
  "abbrev": "CONCAT",
  "dsp": "dsp.so",
  "component_type": "sound_generator",
  "raw_midi": true,
  "min_host_version": "0.9.10",
  "capabilities": {
    "audio_out": true,
    "midi_in": true,
    "chainable": true,
    "component_type": "sound_generator",
    "ui_hierarchy": {
      "modes": null,
      "levels": {
        "root": {
          "name": "Concat",
          "knobs": [
            "x_pos",
            "y_pos",
            "density",
            "grain_size",
            "amp_atk",
            "amp_rel",
            "poly",
            "cutoff"
          ],
          "params": [
            "x_pos",
            "y_pos",
            "density",
            "grain_size",
            "amp_atk",
            "amp_rel",
            "poly",
            "cutoff",
            {
              "level": "corpus",
              "label": "Corpus"
            },
            {
              "level": "map",
              "label": "Map"
            },
            {
              "level": "mod",
              "label": "Mod"
            },
            {
              "level": "grain",
              "label": "Grain"
            },
            {
              "level": "shape",
              "label": "Shape"
            },
            {
              "level": "play",
              "label": "Play"
            },
            {
              "level": "out",
              "label": "Out"
            }
          ]
        },
        "map": {
          "name": "Map",
          "knobs": [
            "x_desc",
            "y_desc",
            "x_pos",
            "y_pos",
            "map_mode",
            "radius",
            "k_nearest",
            "repeat_avoid"
          ],
          "params": [
            "x_desc",
            "y_desc",
            "x_pos",
            "y_pos",
            "map_mode",
            "radius",
            "k_nearest",
            "repeat_avoid"
          ]
        },
        "mod": {
          "name": "Mod",
          "knobs": [
            "follow",
            "lfo_rate",
            "lfo_shape"
          ],
          "params": [
            "follow",
            "lfo_rate",
            "lfo_shape"
          ]
        },
        "grain": {
          "name": "Grain",
          "knobs": [
            "density",
            "grain_size",
            "grain_env",
            "pitch",
            "pan_spread",
            "grain_rand",
            "reverse",
            "pitch_jitter"
