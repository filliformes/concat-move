        "name": "Pan Spread",
        "type": "float",
        "min": 0,
        "max": 1,
        "default": 0.3
      },
      {
        "key": "reverse",
        "name": "Reverse",
        "type": "float",
        "min": 0,
        "max": 1,
        "default": 0
      },
      {
        "key": "play_mode",
        "name": "Play Mode",
        "type": "enum",
        "options": [
          "Map",
          "Notes",
          "Mosaic"
